# Canonical origin of the deployed site, used for canonical tags, og:url, og:image and
# sitemap.xml at build time.
#
# Leave it unset for local builds: the build then omits canonical tags, sitemap.xml and
# robots.txt rather than pointing crawlers at a host that is not serving the site.
#
# On Vercel this is picked up from VERCEL_PROJECT_PRODUCTION_URL, so set it yourself only
# for another host or to override the domain.
SITE_URL=https://example.com
