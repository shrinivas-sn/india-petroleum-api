{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "regions": ["bom1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "data/fuel/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/v1", "destination": "/api/index.js" },
    { "source": "/v1/(.*)", "destination": "/api/index.js" },
    { "source": "/docs", "destination": "/docs/index.html" },
    { "source": "/playground", "destination": "/playground/index.html" },
    { "source": "/status", "destination": "/status/index.html" },
    { "source": "/guides", "destination": "/guides/index.html" },
    { "source": "/guides/:id", "destination": "/guides/:id/index.html" }
  ],
  "headers": [
    {
      "source": "/health",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/v1/prices(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300" }]
    },
    {
      "source": "/v1/cities",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300" }]
    },
    {
      "source": "/v1/meta",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
